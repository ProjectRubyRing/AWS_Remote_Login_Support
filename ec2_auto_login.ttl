; =====================================================================
;  ec2_auto_login.ttl
;    EC2 (RHEL9) 環境へ SSH 接続し自動ログインする Tera Term マクロ。
;
;  動作確認対象:
;    - Tera Term 5 (ver 5.5.2 x64) / Windows 11
;
;  特徴:
;    - ログイン ID・パスワード・IP アドレスをパラメータで指定でき、
;      特定のホストに依存しない汎用マクロとして使えます。
;    - パラメータを省略した場合は、実行時にダイアログで入力を促します。
;    - この .ttl と同じフォルダに「同名の .ini」を自動用意し、その ini で
;      Tera Term を起動します (terraform plan のクリップボード貼り付けに
;      必要なバッファ拡張、aws_login_file.sh の ZMODEM 自動ダウンロード、
;      画面デザインを反映するため)。詳細は下記【設定】セクションを
;      参照してください。
;    - ZMODEM の受信先フォルダ (CFG_FileDir) が無ければ自動作成します。
;
;  実行方法 (コマンドプロンプト / ショートカット / タスク等から):
;    "C:\Program Files\teraterm5\ttpmacro.exe" ec2_auto_login.ttl <user> <password> <ip> [port]
;
;    例:
;    "C:\Program Files\teraterm5\ttpmacro.exe" ec2_auto_login.ttl ec2-user MyP@ssw0rd 10.0.0.15
;    "C:\Program Files\teraterm5\ttpmacro.exe" ec2_auto_login.ttl ec2-user MyP@ssw0rd 10.0.0.15 22
;
;    ※ .ttl を ttpmacro.exe に関連付けておけば、ダブルクリックでも起動できます
;      (その場合はパラメータ省略となり、ダイアログ入力になります)。
;
;  パラメータ (Tera Term マクロのシステム変数):
;    param2 = ログイン ID
;    param3 = パスワード
;    param4 = 接続先 IP アドレス (またはホスト名)
;    param5 = SSH ポート番号 (省略時は 22)
;    ※ param1 はマクロファイル名、paramcnt はマクロ名を含むパラメータ数。
;
;  注意事項:
;    - 初回接続時、未知のホスト鍵に対して確認ダイアログが表示される場合が
;      あります。事前に一度手動で接続して known_hosts に登録しておくと、
;      以降は本マクロで完全自動ログインできます。
;    - パスワードに空白文字を含む場合、コマンドライン渡しではうまく解釈
;      されないことがあります。その場合はパラメータを省略してダイアログ
;      入力を利用してください。
; =====================================================================

; =====================================================================
;  【設定】このマクロが起動する Tera Term 用 ini の自動生成・自動適用
; ---------------------------------------------------------------------
;  この .ttl と同じフォルダに、.ttl と同じ名前の .ini
;  (例: ec2_auto_login.ttl -> ec2_auto_login.ini) を用意し、その ini で
;  Tera Term を起動します。
;    - 同名 ini が既にあれば、それをそのまま読み込んで使います
;      (手動編集した内容を尊重します)。
;    - 無ければ、既定の TERATERM.INI をベースに、下記 CFG_* の値を反映した
;      ini を同名で自動生成し、それを使います。
;  設定を変えたいときは、下記 CFG_* の値を書き換えてください。生成済みの
;  同名 ini がある場合は、その ini を一度削除すると次回起動時に再生成されます。
;  (以前の版で生成した ini には ZMODEM 関連の設定が入っていないため、
;   自動ダウンロードを使う場合は一度削除して再生成してください。)
; ---------------------------------------------------------------------

; --- ベースにする既定の TERATERM.INI のパス --------------------------
;   1つ目が見つからなければ 2つ目を探します。環境に合わせて変更可。
DEFAULT_INI_1 = 'C:\Program Files (x86)\teraterm5\TERATERM.INI'
DEFAULT_INI_2 = 'C:\Program Files\teraterm5\TERATERM.INI'

; --- (A) terraform_plan_clipboard.sh 用: クリップボードのデータサイズ拡張 ---
;   terraform plan の出力を OSC52 でクリップボードへ送る際、受信バッファが
;   小さいと貼り付けが途中で切れます。十分大きな値にしておきます。
;   ※ terraform_plan_clipboard.sh 側でも環境変数 OSC52_BUFFER_LIMIT に
;      同じ値を設定すると、不要な警告表示を抑制できます。
CFG_MaxOSCBufferSize          = '1000000'   ; OSC バッファ上限 (バイト)
;   リモート(SSH先)からのクリップボード書き込みを許可 (off/write/read/on)
CFG_ClipboardAccessFromRemote = 'write'
;   コピーのたびに出る確認ダイアログを抑制 (on/off)
CFG_NotifyClipboardAccess     = 'off'

; --- (B) aws_login_file.sh 用: ZMODEM 自動ダウンロード ----------------
;   aws_login_file.sh は OAuth URL をファイルへ出力し、ZMODEM (sz) で
;   この端末へ送ってきます。自動で受信して指定フォルダへ保存するために、
;   ZMODEM の自動受信を有効にし、ファイル転送のフォルダを指定します。
;   ※ この 2 つは Tera Term の設定ダイアログには項目が無く、ini でのみ
;     設定できます (だからこのマクロで ini を生成しています)。
CFG_ZmodemAuto      = 'on'                ; ホスト側 sz を検知して自動受信 (on/off)
CFG_FileDir         = 'C:\aws_login_url'  ; 受信ファイルの保存先 = ダウンロード先
CFG_AutoFileRename  = 'on'                ; 同名ファイルがあれば自動リネーム
;   保存先フォルダが無ければマクロが作成します。作成をやめたい場合は 0 に。
CREATE_FILEDIR      = 1

; --- (C) Tera Term 画面のデザイン ------------------------------------
CFG_TerminalSize     = '140,40'                ; 端末サイズ  列,行
CFG_EnableScrollBuff = 'on'                     ; スクロールバッファを使う
CFG_ScrollBuffSize   = '100000'                 ; スクロール行数
CFG_VTColor          = '220,220,220,24,24,24'   ; 文字色 R,G,B, 背景色 R,G,B
; フォントも変更したい場合は APPLY_FONT を 1 にしてください。日本語表示が
; 必要なら日本語対応フォント (例 'BIZ UDGothic,0,-19,128') を指定します。
APPLY_FONT           = 0
CFG_VTFont           = 'Consolas,0,-19,0'       ; フォント名,スタイル,サイズ,文字セット
; =====================================================================

; ---------------------------------------------------------------------
; パラメータの取得。省略された場合はダイアログで入力を促す。
; ---------------------------------------------------------------------

; --- ログイン ID ---
if paramcnt >= 2 then
    LOGIN_USER = param2
else
    inputbox 'ログイン ID を入力してください' 'EC2 自動ログイン - ユーザ'
    if result <> 1 then
        end
    endif
    LOGIN_USER = inputstr
endif

; --- パスワード ---
if paramcnt >= 3 then
    LOGIN_PASS = param3
else
    passwordbox 'パスワードを入力してください' 'EC2 自動ログイン - パスワード'
    if result <> 1 then
        end
    endif
    LOGIN_PASS = inputstr
endif

; --- 接続先 IP アドレス / ホスト名 ---
if paramcnt >= 4 then
    HOST_ADDR = param4
else
    inputbox '接続先 IP アドレス (またはホスト名) を入力してください' 'EC2 自動ログイン - ホスト'
    if result <> 1 then
        end
    endif
    HOST_ADDR = inputstr
endif

; --- SSH ポート番号 (省略時は 22) ---
if paramcnt >= 5 then
    SSH_PORT = param5
else
    SSH_PORT = '22'
endif

; ---------------------------------------------------------------------
; 入力チェック (必須項目が空でないこと)
; ---------------------------------------------------------------------
; ※ Tera Term マクロの =/<> は整数専用のため、文字列の比較には
;    strcompare を使う (等しいと result=0 になる)。
strcompare LOGIN_USER ''
if result = 0 then
    messagebox 'ログイン ID が指定されていません。処理を中止します。' 'EC2 自動ログイン - エラー'
    end
endif
strcompare HOST_ADDR ''
if result = 0 then
    messagebox '接続先 IP アドレスが指定されていません。処理を中止します。' 'EC2 自動ログイン - エラー'
    end
endif

; ---------------------------------------------------------------------
; この .ttl と同じフォルダの「同名 .ini」を用意する。
;   INI_PATH = <.ttl のフォルダ>\<.ttl と同じ基底名>.ini
;   例) ec2_auto_login.ttl -> ec2_auto_login.ini
; 既にあればそのまま利用、無ければ既定 ini から生成して利用する。
; ---------------------------------------------------------------------
; マクロのあるフォルダ (getdir) と、マクロのファイル名 (param1) から
; 同名 .ini のフルパスを組み立てる。
getdir MACRO_DIR
basename INI_NAME param1
; 拡張子 (.ttl 等) を .ini へ置き換える。拡張子が無ければ .ini を付与する。
strreplace INI_NAME 1 '\.[^.]+$' '.ini'
if result <> 1 then
    strconcat INI_NAME '.ini'
endif
makepath INI_PATH MACRO_DIR INI_NAME

; 同名 ini が無ければ、既定 TERATERM.INI をベースに生成する。
filesearch INI_PATH
if result = 0 then
    call generate_ini
endif

; ZMODEM の受信先フォルダ (CFG_FileDir) を用意しておく。
; 既に存在する場合は foldercreate が失敗するだけなので結果は見ない。
; ※ foldercreate は途中のフォルダをまとめて作成しないため、
;   深い階層を指定する場合は親フォルダを先に用意してください。
if CREATE_FILEDIR = 1 then
    strcompare CFG_FileDir ''
    if result <> 0 then
        foldercreate CFG_FileDir
    endif
endif

; 最終的に使える ini があるか確認し、あれば起動時に /F= で読み込む。
USE_INI = 0
filesearch INI_PATH
if result = 1 then
    USE_INI = 1
endif

; ---------------------------------------------------------------------
; SSH2 / パスワード認証で接続するためのコマンドラインを組み立てる。
;   <host>:<port> /ssh /2 /auth=password /user=<user> /passwd=<password>
;   さらに、上で用意した同名 ini を設定ファイルとして /F= で指定する。
; ---------------------------------------------------------------------
COMMAND = HOST_ADDR
strconcat COMMAND ':'
strconcat COMMAND SSH_PORT
strconcat COMMAND ' /ssh /2 /auth=password /user='
strconcat COMMAND LOGIN_USER
strconcat COMMAND ' /passwd='
strconcat COMMAND LOGIN_PASS

; 用意した同名 ini を設定ファイルとして使う (/F=...)。
if USE_INI = 1 then
    strconcat COMMAND ' /F="'
    strconcat COMMAND INI_PATH
    strconcat COMMAND '"'
endif

; ---------------------------------------------------------------------
; 接続実行
; ---------------------------------------------------------------------
connect COMMAND

; connect 直後は接続確立に時間がかかる場合があるため、
; シェルプロンプトが表示されるまで待機して結果を確認する。
;   RHEL9 の既定プロンプト:
;     一般ユーザ ... 末尾が '$'
;     root       ... 末尾が '#'
; 認証失敗やタイムアウトも検知する。
timeout = 30
wait '$ ' '# ' '$' '#' 'assword' 'denied' 'refused' 'closed'

if result = 0 then
    ; timeout : プロンプトを検知できなかった
    messagebox '接続がタイムアウトしました。IP アドレス・ポート・ネットワーク到達性を確認してください。' 'EC2 自動ログイン - エラー'
    end
endif

if result >= 5 then
    ; 'assword' / 'denied' / 'refused' / 'closed' を検知
    messagebox '認証に失敗、または接続が拒否されました。ログイン ID とパスワードを確認してください。' 'EC2 自動ログイン - エラー'
    end
endif

; ここまで来ればシェルプロンプトを検知できている = ログイン成功。
; マクロ終了後もそのまま端末操作を続けられるよう、接続は維持したまま終了する。
end

; =====================================================================
;  サブルーチン (call でのみ実行される。end より後ろに置く)
; =====================================================================

; ---------------------------------------------------------------------
; generate_ini:
;   既定の TERATERM.INI (DEFAULT_INI_1 -> DEFAULT_INI_2 の順に探索) を
;   1 行ずつ読み、INI_PATH へ書き出す。[Tera Term] セクション見出しの
;   直後に、上で設定した CFG_* の上書き値を挿入する。
;   Windows の ini 読み出し (GetPrivateProfileString) は同一セクション内で
;   「最初に現れたキー」を採用するため、見出し直後に置いた上書き値が
;   ベース ini の既定値より優先される。
; ---------------------------------------------------------------------
:generate_ini
    ; --- ベースにする既定 ini を探す ---
    SRC_INI = DEFAULT_INI_1
    filesearch SRC_INI
    if result = 0 then
        SRC_INI = DEFAULT_INI_2
        filesearch SRC_INI
        if result = 0 then
            messagebox '既定の TERATERM.INI が見つかりませんでした。ini を生成せず、既定設定のまま接続します。DEFAULT_INI_1 / DEFAULT_INI_2 のパスを確認してください。' 'ini 自動生成 - 警告'
            return
        endif
    endif

    ; --- 読み込み元 (読み取り専用) と書き出し先を開く ---
    fileopen SRCH SRC_INI 0 1
    if SRCH < 0 then
        messagebox '既定 TERATERM.INI を開けませんでした。ini を生成せず接続します。' 'ini 自動生成 - 警告'
        return
    endif
    fileopen DSTH INI_PATH 0
    if DSTH < 0 then
        fileclose SRCH
        messagebox '同名 ini を作成できませんでした。ini を生成せず接続します。' 'ini 自動生成 - 警告'
        return
    endif

    ; --- 1 行ずつコピーしつつ、[Tera Term] 見出しの直後に上書き値を挿入 ---
    INSERTED = 0
    while 1
        filereadln SRCH LINE
        if result = 1 then
            break
        endif
        filewriteln DSTH LINE
        if INSERTED = 0 then
            strscan LINE '[Tera Term]'
            if result = 1 then
                call emit_overrides
                INSERTED = 1
            endif
        endif
    endwhile

    ; --- 万一 [Tera Term] 見出しが無ければ、末尾に追記して上書き値を書く ---
    if INSERTED = 0 then
        filewriteln DSTH ''
        filewriteln DSTH '[Tera Term]'
        call emit_overrides
    endif

    fileclose SRCH
    fileclose DSTH
    return

; ---------------------------------------------------------------------
; emit_overrides:
;   CFG_* の値を "キー=値" 形式で DSTH へ書き出す。生成される ini を
;   Shift-JIS 環境でも安全に保つため、ここで書き出す行は ASCII のみとする。
; ---------------------------------------------------------------------
:emit_overrides
    filewriteln DSTH '; ==== auto-generated overrides by ec2_auto_login.ttl (edit the .ttl CFG_* to change) ===='

    ; (A) terraform_plan_clipboard.sh 用: クリップボードのデータサイズ拡張
    LINEBUF = 'MaxOSCBufferSize='
    strconcat LINEBUF CFG_MaxOSCBufferSize
    filewriteln DSTH LINEBUF
    LINEBUF = 'ClipboardAccessFromRemote='
    strconcat LINEBUF CFG_ClipboardAccessFromRemote
    filewriteln DSTH LINEBUF
    LINEBUF = 'NotifyClipboardAccess='
    strconcat LINEBUF CFG_NotifyClipboardAccess
    filewriteln DSTH LINEBUF

    ; (B) aws_login_file.sh 用: ZMODEM 自動ダウンロード
    LINEBUF = 'ZmodemAuto='
    strconcat LINEBUF CFG_ZmodemAuto
    filewriteln DSTH LINEBUF
    LINEBUF = 'AutoFileRename='
    strconcat LINEBUF CFG_AutoFileRename
    filewriteln DSTH LINEBUF
    ; FileDir は空だと Tera Term の既定 (カレント) になるため、
    ; 指定がある場合だけ書き出す。
    strcompare CFG_FileDir ''
    if result <> 0 then
        LINEBUF = 'FileDir='
        strconcat LINEBUF CFG_FileDir
        filewriteln DSTH LINEBUF
    endif

    ; (C) 画面デザイン
    LINEBUF = 'TerminalSize='
    strconcat LINEBUF CFG_TerminalSize
    filewriteln DSTH LINEBUF
    LINEBUF = 'EnableScrollBuff='
    strconcat LINEBUF CFG_EnableScrollBuff
    filewriteln DSTH LINEBUF
    LINEBUF = 'ScrollBuffSize='
    strconcat LINEBUF CFG_ScrollBuffSize
    filewriteln DSTH LINEBUF
    LINEBUF = 'VTColor='
    strconcat LINEBUF CFG_VTColor
    filewriteln DSTH LINEBUF
    if APPLY_FONT = 1 then
        LINEBUF = 'VTFont='
        strconcat LINEBUF CFG_VTFont
        filewriteln DSTH LINEBUF
    endif

    filewriteln DSTH '; ==== end of auto-generated overrides ===='
    return
